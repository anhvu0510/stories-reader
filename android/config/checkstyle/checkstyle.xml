<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Chặn hoàn toàn empty catch block (nuốt ngoại lệ im lặng) -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore"/>
            <property name="commentFormat" value=".*"/>
        </module>

        <!-- Chặn lồng if sâu hơn 1 cấp (Flat Guard Clauses) -->
        <module name="NestedIfDepth">
            <property name="max" value="1"/>
        </module>

        <!-- Chặn lồng try/catch bên trong try/catch (Single top-level boundary) -->
        <module name="NestedTryDepth">
            <property name="max" value="1"/>
        </module>

        <!-- Đơn giản hóa biểu thức boolean -->
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
    </module>
</module>
