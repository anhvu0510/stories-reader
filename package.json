{
	"name": "stories-reader",
	"private": true,
	"version": "1.0.5",
	"type": "module",
	"scripts": {
		"dev": "vite --port=3000 --host=0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"clean": "rm -rf dist",
		"lint": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\"",
		"lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
		"test": "vitest run",
		"test:android": "bash scripts/test-android.sh",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d dist",
		"cap:sync": "npm run build && npx cap sync android",
		"cap:open": "npx cap open android",
		"cap:build": "bash scripts/build-apk.sh",
		"cap:telegram": "bash scripts/send-telegram.sh",
		"cap:build:telegram": "npm run cap:build && bash scripts/send-telegram.sh",
		"ota:pack": "bash scripts/pack-ota.sh",
		"format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
		"prepare": "husky",
		"lint:strict": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.2",
		"@capacitor/core": "^8.5.2",
		"@capgo/capacitor-updater": "^8.52.1",
		"@google/genai": "^1.29.0",
		"@tailwindcss/vite": "^4.1.14",
		"@vitejs/plugin-react": "^5.0.4",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.3",
		"express": "^4.21.2",
		"idb": "^8.0.3",
		"lucide-react": "^0.546.0",
		"motion": "^12.23.24",
		"oboe": "^2.1.7",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "^7.14.2",
		"tailwind-merge": "^3.5.0",
		"vite": "^6.2.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.6.9",
		"@eslint/js": "^9.39.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/express": "^4.17.21",
		"@types/node": "^22.14.0",
		"@types/oboe": "^2.1.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-unicorn": "^65.0.1",
		"fake-indexeddb": "^6.2.5",
		"gh-pages": "^6.3.0",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^15.5.2",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.21.0",
		"typescript": "~5.8.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^6.2.0",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"eslint --fix --max-warnings 20",
			"prettier --write"
		],
		"src/**/*.{css,json}": [
			"prettier --write"
		]
	}
}
